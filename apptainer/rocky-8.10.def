Bootstrap: docker
From: rockylinux/rockylinux:8.10

%post
    ######################################################################
    # System Packages

    # Update the system
    dnf -y update

    dnf install -y dnf-plugins-core epel-release
    dnf config-manager --set-enabled powertools
    dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo

    # Install packages -- sort with .+1,/^$/-1!sort
    dnf -y install \
        autoconf \
        boost1.78-devel \
        boost1.78-static \
        cairo-devel \
        cairo-gobject-devel \
        clang-20.1.8 \
        clang-devel-20.1.8 \
        clang-tools-extra-20.1.8 \
        cmake \
        crun \
        curl \
        flex \
        gcc-toolset-14 \
        gcc-toolset-14-libasan-devel \
        gcc-toolset-14-libatomic-devel \
        gcc-toolset-14-libubsan-devel \
        gh \
        git \
        git-lfs \
        glib2-devel \
        gobject-introspection-devel \
        gperftools \
        gtk3 \
        help2man \
        htop \
        hwloc \
        jemalloc-devel \
        jq \
        lcov \
        libXScrnSaver \
        libevent-devel \
        libglvnd-glx \
        libnsl \
        libpng12 \
        lld-20.1.8 \
        lz4-devel \
        make \
        mold \
        moreutils \
        ncurses-compat-libs \
        ncurses-devel \
        numactl \
        perf \
        perl \
        podman \
        python3.12-devel \
        python3.12-pip \
        redhat-lsb-core \
        rsync \
        strace \
        valgrind \
        vmtouch \
        wget \
        which \
        xorg-x11-apps \
        xz \
        zlib-devel \
        zsh \

    # Clean up
    dnf clean all
    rm -rf /var/cache/dnf

    ######################################################################
    # Python packages

    python3 -m pip install \
        icdiff \
        PyGObject==3.44.2 \
        xdot \

    ######################################################################
    # Default gcc-toolset-14 for remaining steps

    source scl_source enable gcc-toolset-14

    ######################################################################
    # Install nodejs version manager 'n' and never nodejs

    curl -fsSL -o /usr/local/bin/n https://raw.githubusercontent.com/tj/n/master/bin/n
    chmod 0755 /usr/local/bin/n
    n install 24

    ######################################################################
    # Install Claude CLI

    npm install -g @anthropic-ai/claude-code

    ######################################################################
    # Install rustup and rust/cargo

    export RUSTUP_HOME=/opt/rustup
    export CARGO_HOME=/opt/cargo
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.92.0
    export PATH="$CARGO_HOME/bin:$PATH"

    ######################################################################
    # Install wavetools

    cargo install --root /usr/local wavetools

    ######################################################################
    # Build and install recent Vim

    git clone https://github.com/vim/vim.git vim
    pushd vim/src
    git checkout v9.1.1930
    make -j$(nproc)
    make install
    popd
    rm -rf vim

    ######################################################################
    # Build and install a recent version of bison

    BISON=bison-3.8.2
    wget https://mirror.cyberbits.eu/gnu/bison/$BISON.tar.xz
    tar xJfv $BISON.tar.xz
    pushd $BISON
    ./configure
    make -j$(nproc)
    make install
    popd
    rm -rf $BISON.tar.xz $BISON

    ######################################################################
    # Build and install recent tmux - needs bison

    git clone https://github.com/tmux/tmux.git tmux
    pushd tmux
    git checkout 3.6a
    sh autogen.sh
    ./configure
    make -j$(nproc)
    make install
    popd
    rm -rf tmux

    ######################################################################
    # Build and install a recent version of ccache

    git clone https://github.com/ccache/ccache.git ccache
    pushd ccache
    git checkout v4.13.6
    mkdir build
    cmake -S . -B build -D CMAKE_BUILD_TYPE=Release
    cmake --build build -j$(nproc) -- install
    popd
    rm -rf ccache

    ######################################################################
    # Build and install SystemC

    git clone https://github.com/accellera-official/systemc.git systemc
    pushd systemc
    git checkout 3.0.2
    mkdir build
    cmake -S . -B build -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j$(nproc) -- install
    popd
    rm -rf systemc

    ######################################################################
    # Build and install z3

    git clone https://github.com/Z3Prover/z3.git z3
    pushd z3
    git checkout z3-4.16.0
    mkdir build
    cmake -S . -B build -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_PREFIX=/usr/local
    cmake --build build -j$(nproc) -- install
    popd
    rm -rf z3

    ######################################################################
    # Build and install bear
    git clone https://github.com/rizsotto/Bear.git bear
    pushd bear
    git checkout 4.1.3
    cargo build --release
    PREFIX=/usr/local ./scripts/install.sh
    popd
    rm -rf bear

%environment
    export LC_ALL=C.UTF-8

%runscript
    #!/bin/bash
    echo "=== Rocky Linux 8.10 Dev Container ==="
    source scl_source enable gcc-toolset-14
    exec "${SHELL:-/bin/sh}" "$@"
